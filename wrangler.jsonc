{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growth-workspace",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",

  "vars": {
    "APP_ENV": "development",
    // AI execution (STEP 6, see docs/ai-execution.md):
    // AI_PROVIDER: 'workers-ai' (default) or 'echo' (offline local dev).
    // AI_GATEWAY_ID: set to route Workers AI through AI Gateway.
    // AI_MODEL_DEFAULT: optional model id override for the 'default' strategy.
    "AI_PROVIDER": "workers-ai"
  },

  // Workers AI binding. Chief and all future AI execution go through this
  // (optionally via AI Gateway). Binding-based: no API keys in code or D1.
  "ai": {
    "binding": "AI"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "growth-workspace",
      // Placeholder: local dev and `vite preview` use local D1 state and never
      // touch this id. Replace with the real id from `wrangler d1 create
      // growth-workspace` before `npm run deploy` / `db:migrate:remote`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]

  // Future bindings (not active yet): R2 buckets, Workflows, Queues,
  // AI Gateway. Add them here when activated and run `npm run cf-typegen`.
}
