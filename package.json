{
  "name": "growth-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "wrangler d1 execute DB --local --file=./seed.sql",
    "db:test": "node scripts/test-db.mjs",
    "test:relations": "node --experimental-strip-types scripts/test-relations.ts",
    "test:chat": "node --experimental-strip-types scripts/test-chat.ts",
    "test:context": "node --experimental-strip-types scripts/test-context.ts",
    "test:ai": "node --experimental-strip-types scripts/test-ai.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.30",
    "@tanstack/react-start": "^1.168.47",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@cloudflare/vite-plugin": "^1.53.0",
    "better-sqlite3": "^12.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.124.0"
  }
}
